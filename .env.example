# OpenCall AI — environment template. Copy to .env.local and fill in.
# NEVER commit .env.local or real values.

# ---- Mode ----
OPENCALL_MODE=internet-only
PSTN_ENABLED=false
RECORDING_ENABLED=false
ALLOW_PAID_RESOURCES=false
LOCAL_AI=true

# ---- Core services ----
API_PORT=4000
WEB_URL=http://localhost:3000
DATABASE_URL=sqlite://data/opencall.db
REDIS_URL=
SESSION_SECRET=change-me-generate-a-long-random-string

# ---- Realtime (LiveKit) ----
REALTIME_PROVIDER=livekit
LIVEKIT_MODE=self-hosted
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=opencalldevsecret_0123456789abcdef0123456789abcdef

# ---- TURN (optional, for restrictive NATs) ----
TURN_URL=
TURN_USERNAME=
TURN_SECRET=

# ---- Local AI (OpenAI-compatible endpoint; LM Studio / Ollama / llama.cpp) ----
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=local
LLM_MODEL=qwen2.5-7b-instruct

STT_PROVIDER=faster-whisper
STT_MODEL=base.en
TTS_PROVIDER=kokoro
TTS_VOICE=af_heart

# ---- PSTN / BYOC (disabled by default; never enabled without a legitimate trunk) ----
SIP_SERVER=
SIP_USERNAME=
SIP_PASSWORD=
